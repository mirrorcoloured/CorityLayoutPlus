{
  "name": "CorityLayout+",
  "description": "Enhance Cority layout editing by making information more visible",
  "version": "1.5.0",
  "author": "Sky Chrastina",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "browser_action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "CorityLayout+"
  },
  "options_page": "options.html",
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "http://*.cority.com/*/layout.rails*",
        "https://*.cority.com/*layout.rails*"
      ],
      "js": [
        "layoutscript.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "http://*.cority.com/*/display.rails*",
        "https://*.cority.com/*display.rails*"
      ],
      "js": [
        "formscript.js"
      ],
      "run_at": "document_end"
    }
  ],
  "manifest_version": 2
}